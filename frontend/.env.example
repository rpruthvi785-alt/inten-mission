# =============================================================
# Three-Way Match Engine — Frontend Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit your actual .env.local file to git.
# =============================================================

# Backend API URL
# For local development, point to your local backend:
NEXT_PUBLIC_API_URL=http://localhost:5000

# For production GitHub Pages deployment, set this in GitHub Actions secrets:
# GitHub repo → Settings → Secrets and variables → Actions → New repository secret
# Name:  NEXT_PUBLIC_API_URL
# Value: https://your-backend.railway.app
#
# If the secret is not set, the deployed app shows a "Configure Backend URL"
# setup screen on the login page — users can enter the backend URL there.

# GitHub Pages base path (set automatically by GitHub Actions — do not change)
# NEXT_PUBLIC_BASE_PATH=/inten-mission
